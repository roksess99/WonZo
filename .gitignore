# Secrets — nooit in Git. .env.example is de uitzondering en bevat geen waarden.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# Persoonlijke Claude Code-instellingen
.claude/settings.local.json
CLAUDE.local.md

# Dependencies en build-uitvoer
node_modules/
.pnpm-store/
dist/
build/
out/
.next/
coverage/
*.tsbuildinfo

# Logs en tijdelijke bestanden
*.log
.DS_Store
Thumbs.db
tmp/

# Next.js en tooling (toegevoegd bij de opzet van fase 1)
next-env.d.ts
.vercel/
.pnp
.pnp.*
npm-debug.log*
.pnpm-debug.log*

# Claude Code: alleen wat het project zelf regelt gaat in Git — regels, hooks,
# de gedeelde instellingen en de dev-server. Al het andere in .claude/
# (persoonlijke agents en skills, zoals de SEO-set) blijft lokaal. Zonder deze
# uitzonderingen zou een nieuw regelbestand of een nieuwe hook stil buiten Git
# blijven.
.claude/*
!.claude/rules/
!.claude/hooks/
!.claude/settings.json
!.claude/launch.json

# Lokale uitvoer van de brag-video (groot, opnieuw te maken)
brag-output/
