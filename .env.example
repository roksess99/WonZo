# Voorbeeldwaarden voor WonZo.
#
# LET OP: dit bestand staat WEL in Git. Zet hier nooit een echte sleutel of een
# wachtwoord in — de guard-hook weigert een niet-lege waarde bij variabelen met
# TOKEN, SECRET, PASSWORD of KEY in de naam. Kopieer naar `.env` en vul daar de
# echte waarden in; `.env` staat in .gitignore en is voor Claude niet leesbaar.
#
# Staat er ooit toch een echte sleutel in een commit: roteer hem. Een commit
# weghalen haalt de sleutel niet uit de kopieën die anderen al hebben.
#
# De applicatie valideert deze variabelen bij het opstarten en weigert te
# starten als er een ontbreekt of een verkeerde vorm heeft.

# --- De site zelf ---------------------------------------------------------
# Volledig adres mét protocol: canonicals, deelplaatjes, terugkeer-URL van de
# betaaldienst. De prefix NEXT_PUBLIC_ (Next.js, D-00) maakt de waarde
# publiek in de browserbundel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Leverancier (BigBuy, docs/api/LEVERANCIER.md) -----------------------
# Server-side. Komt nooit in de browser. Leeg = de mock wordt gebruikt.
# API-sleutel uit het BigBuy-account; gaat mee als "Authorization: Bearer ...".
# Let op: de sandbox en productie hebben elk hun eigen sleutel (AANNAME — meten).
# Met deze sleutel kan ook besteld worden: BigBuy kent één sleutel per account
# (GEDOCUMENTEERD: één vorm van authenticatie), geen aparte bestelsleutel.
SUPPLIER_API_TOKEN=
# Omgeving: https://api.sandbox.bigbuy.eu (test) of https://api.bigbuy.eu
# (productie). Verplicht in te vullen; de applicatie kiest nooit zelf productie.
SUPPLIER_BASE_URL=
# Taal van productnamen en omschrijvingen (isoCode; BigBuy-standaard is "es").
# Of "nl" beschikbaar is: meten (LEVERANCIER § 9).
SUPPLIER_LANGUAGE=
# Mock-scenario in ontwikkeling (docs/SUPPLIER_RESILIENCE.md), bijv. unavailable
# CATALOG_MOCK_SCENARIO=
# Waar de catalogus vandaan komt (D-31): "mock" (standaard) of "database" (de
# kopie die het verversen bijhoudt; vraagt DATABASE_*). Live blijft "mock" tot
# de prijsregel vaststaat (D-03).
CATALOG_SOURCE=

# --- Prijsbeleid (leeg tot D-03 en D-16 beslist zijn) ---------------------
# Minimale marge op de kostprijs als er geen prijsregel is, in procenten
MIN_MARGIN_PERCENT=
# "true" of "false": de adviesprijs van de leverancier gebruiken of negeren
USE_RECOMMENDED_PRICE=

# --- Database (D-06: MariaDB bij Hostinger) --------------------------------
# Leeg = geen database: de winkel draait dan op de voorbeeldcatalogus.
# Lokaal: de gegevens van wonzo_dev (host via Remote MySQL, alleen je eigen
# IP), nooit die van de live database. Op Hostinger: die van wonzo, in de
# omgevingsvariabelen van de app. `pnpm build` draait eerst de migraties
# tegen deze database (D-06); `pnpm db:status` laat zien wat er openstaat.
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# --- Testdatabase (alleen lokaal) ------------------------------------------
# Voor de integratietests (`pnpm test:db`): een eigen database met "test" in
# de naam (wonzo_test), via Remote MySQL met alleen je eigen IP. De tests
# schrijven bestellingen; ze weigeren een naam zonder "test" en de database
# van DATABASE_NAME. Niet op Hostinger zetten.
TEST_DATABASE_HOST=
TEST_DATABASE_PORT=
TEST_DATABASE_NAME=
TEST_DATABASE_USER=
TEST_DATABASE_PASSWORD=

# --- Betaaldienst (D-05) --------------------------------------------------
# Een testsleutel op een ontwikkelmachine. Een live sleutel hier betekent dat
# elke druk op "betalen" echt geld verplaatst.
PAYMENT_API_KEY=
# Geheim om de handtekening van webhooks te controleren, als de dienst dat biedt
PAYMENT_WEBHOOK_SECRET=

# --- Mail (soort koppeling volgt uit D-29; SMTP is een AANNAME) ------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Afzender en het adres waar bestellingen naartoe gaan
MAIL_FROM=
MAIL_ORDERS_TO=
# In ontwikkeling: alle mail naar dit adres in plaats van naar de klant
# MAIL_REDIRECT_TO=

# --- Beheerpaneel ---------------------------------------------------------
# Sleutel waarmee het TOTP-geheim versleuteld in de database staat.
# 32 willekeurige bytes, hex. Verlies je hem, dan kan niemand meer inloggen —
# bewaar hem ook in de wachtwoordkluis (docs/DISASTER_RECOVERY.md).
ADMIN_TOTP_KEY=

# --- Geplande taken -------------------------------------------------------
# De cron-taak stuurt dit mee als bearer-token (POST /api/cron/catalog).
# Minstens 32 tekens, willekeurig: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leeg = de cron-adressen bestaan niet (404).
JOB_TOKEN=
